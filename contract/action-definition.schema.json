{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harnsy:actions:1:action-definition",
  "title": "harnsy action definition",
  "description": "An action as an agent proposes it (POST /api/actions, MCP harnsy_action_propose). Contract 1.1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name"
  ],
  "oneOf": [
    {
      "required": [
        "script"
      ]
    },
    {
      "required": [
        "command"
      ]
    }
  ],
  "properties": {
    "from": {
      "type": "string",
      "description": "the proposing agent's name (an agent seated in a team of the project); the API only"
    },
    "project": {
      "type": "string",
      "description": "the project's id or name; the API only"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
      "description": "unique in the project; the same name again is a new version"
    },
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lang",
        "body"
      ],
      "properties": {
        "lang": {
          "enum": [
            "bash",
            "sh",
            "python",
            "node",
            "go"
          ]
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "description": "up to 65536 characters"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "description": "argv[0] a relative path of a file in the project; {name} stands for a parameter"
        }
      }
    },
    "cwd": {
      "type": "string",
      "default": ".",
      "description": "relative, inside the project's directory"
    },
    "params": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "type": {
            "enum": [
              "enum",
              "int",
              "bool",
              "commit",
              "item"
            ]
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[^-]"
            }
          },
          "min": {
            "type": "integer"
          },
          "max": {
            "type": "integer"
          },
          "default": {
            "description": "used when the run gives no value; for commit a ref such as HEAD or master",
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 80
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "enum"
                }
              }
            },
            "then": {
              "required": [
                "values"
              ]
            }
          }
        ]
      }
    },
    "env": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
        "not": {
          "pattern": "^([Hh][Aa][Rr][Nn][Ss][Yy]|[Cc][Cc][Bb][Uu][Ss]|[Aa][Cc][Tt][Ii][Oo][Nn])_"
        }
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "timeout": {
      "type": "string",
      "description": "a Go duration such as 15m, 1h30m or 1h0m0s; 1m to 2h; default 30m",
      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
    },
    "heavy": {
      "type": "boolean",
      "description": "start only while the machine has room (memory, load)"
    },
    "marks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "restarts_node",
          "deletes",
          "network"
        ]
      }
    },
    "pin": {
      "type": "boolean",
      "description": "a tile on the dashboard's Home"
    },
    "numbers": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "label": {
            "type": "string",
            "maxLength": 80
          },
          "of": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          }
        }
      }
    }
  }
}
